# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
# text = readable lines; json = one JSON object per line (for log collectors)
LOG_FORMAT=text

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
# Prices in USD per 1M tokens, for cost estimates (no defaults; unset = cost reported unknown)
OPENAI_CHAT_INPUT_PER_MTOK=
OPENAI_CHAT_OUTPUT_PER_MTOK=0
OPENAI_EMBEDDING_PER_MTOK=
# true = informational replies (order status, policy text) are rephrased by the LLM behind a
# grounding check; refunds, cancellations, approvals and handoffs always stay template text
LLM_REPLIES_ENABLED=false

# PostgreSQL
DATABASE_URL=postgresql+psycopg://supportx:change-me@localhost:5432/supportx

# Protects the staff endpoints (approve/reject refunds). Use a long random value; blank = disabled.
STAFF_API_KEY=
# Personal keys (preferred): name:key pairs, keys at least 16 characters. The approver recorded on
# a decision is then the key's name, not what the caller types. Example: jane:LONG-RANDOM-1,bob:LONG-RANDOM-2
STAFF_API_KEYS=

# Ticket workflow files (defaults shown)
CHECKPOINT_DB_PATH=supportx_checkpoints.db
INTENT_MODEL_PATH=artifacts/models/intent_tfidf_lr_bitext_aug.joblib
POLICY_DOCS_DIR=data/sample/policies

# Business rules. These are DEMO numbers; replace with the real policy, then set CONFIRMED=true.
BUSINESS_RULES_VERSION=demo-1
REFUND_RETURN_WINDOW_DAYS=30
REFUND_NOT_RECEIVED_AFTER_DAYS=14
BUSINESS_RULES_CONFIRMED=false

# Follow-ups after approved refunds/cancellations (payment, stock, customer message) go to an outbox.
# disabled = saved but not delivered; mock = the worker uses MOCK adapters (nothing real happens).
INTEGRATIONS_MODE=disabled
OUTBOX_MAX_ATTEMPTS=5

# Minimum score for a policy passage to be quoted (0.1 = answer almost always; ~0.2 = balanced; see E9)
RETRIEVAL_MIN_SCORE=0.1

# Tickets with intent confidence below this go to a human (0.0 - 1.0)
INTENT_MIN_CONFIDENCE=0.6

# Per-client rate limits per minute (0 = unlimited) and wrong staff keys allowed before a lockout
RATE_LIMIT_PER_MINUTE=120
AUTH_FAILURES_PER_MINUTE=10

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
