# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# PostgreSQL
DATABASE_URL=postgresql+psycopg://supportx:change-me@localhost:5432/supportx

# Protects the staff endpoints (approve/reject refunds). Use a long random value; blank = disabled.
STAFF_API_KEY=

# Tickets with intent confidence below this go to a human (0.0 - 1.0)
INTENT_MIN_CONFIDENCE=0.6

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
