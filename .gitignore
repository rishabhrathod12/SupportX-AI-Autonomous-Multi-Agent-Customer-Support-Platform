# Virtual environments
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets - NEVER commit
.env
.env.*
!.env.example

# Data (large / possibly sensitive). Only .gitkeep and small sample data are tracked.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model & vector-store artifacts
artifacts/models/*
artifacts/vectorstore/*
!artifacts/models/.gitkeep
!artifacts/vectorstore/.gitkeep
*.keras
*.h5
*.joblib
*.pkl
*.faiss

# MLflow
mlruns/
mlartifacts/
mlflow.db

# Local databases (app data and paused-ticket checkpoints)
supportx*.db

# Notebooks
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local demo databases
demo.db
demo_checkpoints.db*
